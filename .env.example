# GridOps Intelligence local configuration example.
# Copy this file to .env and replace placeholder values as needed.
# Never commit real credentials.

GRIDOPS_APP_NAME=GridOps Intelligence
GRIDOPS_APP_ENVIRONMENT=local
GRIDOPS_LOG_LEVEL=INFO
GRIDOPS_API_HOST=127.0.0.1
GRIDOPS_API_PORT=8000
GRIDOPS_DATABASE_URL=postgresql+psycopg://gridops:replace-me@localhost:55432/gridops
GRIDOPS_READINESS_TIMEOUT_SECONDS=2.0