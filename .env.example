# GridOps Intelligence local configuration example.
# Copy this file to .env and replace placeholder values as needed.
# Never commit real credentials.

GRIDOPS_APP_NAME=GridOps Intelligence
GRIDOPS_APP_ENVIRONMENT=local
GRIDOPS_LOG_LEVEL=INFO
GRIDOPS_API_HOST=127.0.0.1
GRIDOPS_API_PORT=8000
GRIDOPS_DATABASE_URL=postgresql+psycopg://gridops:replace-me@localhost:55432/gridops
GRIDOPS_READINESS_TIMEOUT_SECONDS=2.0
# Comma-separated browser origins. Set this to the deployed frontend URL in production.
GRIDOPS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GRIDOPS_DEMO_MODE=false
GRIDOPS_DEMO_SCENARIO_LOAD_GROWTH_PERCENT_LIMIT=10
GRIDOPS_DEMO_SCENARIO_ADDED_LOAD_MW_LIMIT=2000
GRIDOPS_DEMO_SCENARIO_TEMPERATURE_DELTA_C_LIMIT=10
GRIDOPS_DEMO_SCENARIO_HUMIDITY_DELTA_PERCENT_LIMIT=30
